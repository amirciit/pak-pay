{
    "name": "pak-pay/pak-pay",
    "description": "A single unified Laravel API for accepting payments through Pakistani payment gateways (JazzCash, EasyPaisa, Safepay, NayaPay, PayFast, Raast).",
    "keywords": [
        "laravel",
        "payments",
        "pakistan",
        "jazzcash",
        "easypaisa",
        "safepay",
        "nayapay",
        "payfast",
        "raast",
        "payment-gateway"
    ],
    "homepage": "https://github.com/imabbas8/pak-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Abbas Aslam",
            "email": "imabbasaslam8@gmail.com",
            "homepage": "https://github.com/imabbas8",
            "role": "Developer"
        },
        {
            "name": "Debug Flow",
            "email": "support@debugflow.com",
            "homepage": "https://debugflow.com",
            "role": "Company"
        }
    ],
    "support": {
        "issues": "https://github.com/imabbas8/pak-pay/issues",
        "source": "https://github.com/imabbas8/pak-pay"
    },
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^1.21 || ^2.0 || ^3.0",
        "pestphp/pest-plugin-laravel": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "PakPay\\PakPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PakPay\\PakPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PakPay\\PakPay\\PakPayServiceProvider"
            ],
            "aliases": {
                "PakPay": "PakPay\\PakPay\\Facades\\PakPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
